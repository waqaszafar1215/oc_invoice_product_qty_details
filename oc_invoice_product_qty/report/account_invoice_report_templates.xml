<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_oc_invoice_total_quantity" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='payment_term']" position="after">
            <p t-if="o.total_product" groups='oc_invoice_product_qty.group_show_product_and_quantity_in_invoice'>
                <strong >Total Products:</strong>
                <span t-field="o.total_product"/>
            </p>
            <p t-if="o.total_quantity" groups='oc_invoice_product_qty.group_show_product_and_quantity_in_invoice'>
                <strong >Total Quantity:</strong>
                <span t-field="o.total_quantity"/>
            </p>
        </xpath>
    </template>

</odoo>
